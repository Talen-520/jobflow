{
  "name": "jobflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app/desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:tauri": "node scripts/dev.mjs --tauri",
    "smoke": "node scripts/smoke.mjs",
    "desktop:dev": "npm --workspace app/desktop run dev",
    "desktop:build": "npm --workspace app/desktop run build",
    "desktop:test": "node --test app/desktop/tests/*.test.cjs",
    "desktop:tauri": "npm --workspace app/desktop run tauri",
    "backend:test": "cd app/backend && uv run pytest",
    "extension:test": "node --test app/extension/tests/*.test.cjs",
    "extension:check": "node --check app/extension/background.js && node --check app/extension/content.js && node --check app/extension/jobflow-dom.js && node --check app/extension/popup-state.js && node --check app/extension/popup.js",
    "backend:sidecar": "node scripts/build-sidecar.mjs",
    "backend:sidecar:smoke": "node scripts/smoke-sidecar.mjs"
  }
}
